# Chave da Google Gemini API (obtenha gratuitamente em https://aistudio.google.com/apikey)
# Se voce assina Google AI Pro, vincule seus US$ 10/mes de creditos no Google AI Studio!
GEMINI_API_KEY=

# Modelo primario (com fallback automatico para gemini-3.1-flash-lite e gemini-2.5-flash-lite)
FOCUS_GUARD_AI_MODEL=gemini-3.5-flash-lite

# Limites financeiros diarios e mensais em USD (trava BudgetGuard)
FOCUS_GUARD_MAX_DAILY_USD=0.35
FOCUS_GUARD_MAX_MONTHLY_USD=8.00

# Porta do dashboard local (127.0.0.1 apenas)
FOCUS_GUARD_PORT=8765
